  "private": true,
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts",
    "format": "prettier --write src tests scripts docs README.md package.json next.config.mjs eslint.config.mjs",
    "format:check": "prettier --check src tests scripts docs README.md package.json next.config.mjs eslint.config.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node scripts/smoke.cjs",
    "db:check": "node scripts/check-supabase.cjs",
    "shipping:check": "node scripts/check-shipping.cjs",
    "smtp:check": "node scripts/check-smtp.cjs",
    "olist:check": "node scripts/check-olist.cjs",
    "olist:preflight": "node scripts/olist-preflight.cjs",
    "email:templates": "node scripts/export-email-templates.cjs",
    "checkout:check": "node scripts/check-checkout.cjs",
    "checkout:preflight": "node scripts/checkout-preflight.cjs",
    "checkout:replay": "node scripts/replay-payment-webhook.cjs",
    "checkout:job": "node scripts/run-commerce-job.cjs",
    "test:payments": "node --test tests/orders.test.cjs tests/payment-shipping.test.cjs tests/checkout-integrations-database.test.cjs tests/payment-homologation.test.cjs tests/checkout-tools.test.cjs tests/pix-status.test.cjs"
  },
  "dependencies": {
    "@sparticuz/chromium": "153.0.0",
